# Copiez ce fichier en .env et remplissez la clé. Ne commitez jamais .env.
RODIUM_API_KEY=rd_sk_...
RODIUM_BASE_URL=https://api.rodiumai.io/v1
# Tout identifiant de modèle listé par GET https://api.rodiumai.io/v1/models avec "supports_tools": true
MODELE=anthropic/claude-haiku-5-5
MODELE_JUGE=anthropic/claude-haiku-5-5
MAX_STEPS=8
MAX_REPRISES=2
